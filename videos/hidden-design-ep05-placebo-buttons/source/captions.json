[
 {
  "start": 0.15,
  "end": 0.93,
  "text": "That door close button"
 },
 {
  "start": 0.93,
  "end": 2.302,
  "text": "in the elevator?"
 },
 {
  "start": 2.322,
  "end": 3.378,
  "text": "Bad news."
 },
 {
  "start": 3.398,
  "end": 4.862,
  "text": "Come on, come on, come on!"
 },
 {
  "start": 4.882,
  "end": 6.162,
  "text": "In many elevators,"
 },
 {
  "start": 6.162,
  "end": 7.486,
  "text": "it doesn't do anything."
 },
 {
  "start": 7.506,
  "end": 8.366,
  "text": "In the US,"
 },
 {
  "start": 8.366,
  "end": 9.376,
  "text": "accessibility rules say"
 },
 {
  "start": 9.376,
  "end": 11.066,
  "text": "the doors must stay open"
 },
 {
  "start": 11.066,
  "end": 12.711,
  "text": "long enough for everyone."
 },
 {
  "start": 12.731,
  "end": 13.801,
  "text": "So the close button"
 },
 {
  "start": 13.801,
  "end": 14.641,
  "text": "often only works"
 },
 {
  "start": 14.641,
  "end": 16.265,
  "text": "with a firefighter's key."
 },
 {
  "start": 16.285,
  "end": 17.615,
  "text": "You're not pressing a button."
 },
 {
  "start": 17.615,
  "end": 19.04,
  "text": "You're pressing a feeling."
 },
 {
  "start": 19.06,
  "end": 20.881,
  "text": "And it's not just elevators."
 },
 {
  "start": 20.901,
  "end": 22.951,
  "text": "In New York, a 2004 report"
 },
 {
  "start": 22.951,
  "end": 24.981,
  "text": "found most crosswalk buttons"
 },
 {
  "start": 24.981,
  "end": 26.305,
  "text": "did nothing at all."
 },
 {
  "start": 26.325,
  "end": 27.453,
  "text": "Any minute now."
 },
 {
  "start": 27.473,
  "end": 28.703,
  "text": "Some office thermostats"
 },
 {
  "start": 28.703,
  "end": 29.853,
  "text": "are fake too,"
 },
 {
  "start": 29.853,
  "end": 31.353,
  "text": "installed just to stop people"
 },
 {
  "start": 31.353,
  "end": 32.503,
  "text": "complaining about"
 },
 {
  "start": 32.503,
  "end": 33.54,
  "text": "the temperature."
 },
 {
  "start": 33.56,
  "end": 35.524,
  "text": "They're called placebo buttons."
 },
 {
  "start": 35.544,
  "end": 36.534,
  "text": "And honestly?"
 },
 {
  "start": 36.534,
  "end": 37.384,
  "text": "They kind of work,"
 },
 {
  "start": 37.384,
  "end": 38.954,
  "text": "because you feel in control."
 },
 {
  "start": 38.974,
  "end": 40.164,
  "text": "Now go press one."
 },
 {
  "start": 40.164,
  "end": 41.442,
  "text": "You know you want to."
 },
 {
  "start": 41.462,
  "end": 42.362,
  "text": "Follow for more"
 },
 {
  "start": 42.362,
  "end": 43.149,
  "text": "hidden designs."
 }
]
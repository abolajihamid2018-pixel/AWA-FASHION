[
 {
  "start": 0.15,
  "end": 1.39,
  "text": "Look at a plane window."
 },
 {
  "start": 1.39,
  "end": 2.704,
  "text": "See the tiny hole?"
 },
 {
  "start": 2.724,
  "end": 3.424,
  "text": "Don't worry."
 },
 {
  "start": 3.424,
  "end": 4.775,
  "text": "It won't suck you out."
 },
 {
  "start": 4.795,
  "end": 6.455,
  "text": "A plane window is actually"
 },
 {
  "start": 6.455,
  "end": 7.303,
  "text": "three panes."
 },
 {
  "start": 7.323,
  "end": 8.723,
  "text": "Up high, the cabin air"
 },
 {
  "start": 8.723,
  "end": 10.243,
  "text": "pushes hard against them."
 },
 {
  "start": 10.263,
  "end": 10.963,
  "text": "The hole sits"
 },
 {
  "start": 10.963,
  "end": 12.235,
  "text": "in the middle pane."
 },
 {
  "start": 12.255,
  "end": 13.375,
  "text": "It lets air through,"
 },
 {
  "start": 13.375,
  "end": 14.445,
  "text": "so the outer pane"
 },
 {
  "start": 14.445,
  "end": 15.428,
  "text": "takes the pressure."
 },
 {
  "start": 15.448,
  "end": 16.338,
  "text": "The middle pane"
 },
 {
  "start": 16.338,
  "end": 17.245,
  "text": "is the backup."
 },
 {
  "start": 17.265,
  "end": 17.815,
  "text": "And the hole"
 },
 {
  "start": 17.815,
  "end": 19.252,
  "text": "has one more job."
 },
 {
  "start": 19.272,
  "end": 20.842,
  "text": "It lets moisture escape,"
 },
 {
  "start": 20.842,
  "end": 21.712,
  "text": "so your window"
 },
 {
  "start": 21.712,
  "end": 22.563,
  "text": "doesn't fog up."
 },
 {
  "start": 22.583,
  "end": 24.221,
  "text": "So you can enjoy the view."
 },
 {
  "start": 24.241,
  "end": 25.141,
  "text": "Follow for more"
 },
 {
  "start": 25.141,
  "end": 25.929,
  "text": "hidden designs."
 }
]
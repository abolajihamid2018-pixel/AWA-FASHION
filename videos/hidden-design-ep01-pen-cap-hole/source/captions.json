[
 {
  "start": 0.15,
  "end": 1.33,
  "text": "See this tiny hole"
 },
 {
  "start": 1.33,
  "end": 2.259,
  "text": "in your pen cap?"
 },
 {
  "start": 2.279,
  "end": 3.845,
  "text": "It's not there for the ink."
 },
 {
  "start": 3.865,
  "end": 4.755,
  "text": "And it's not"
 },
 {
  "start": 4.755,
  "end": 5.88,
  "text": "to keep the tip dry."
 },
 {
  "start": 5.9,
  "end": 7.03,
  "text": "Kids chew on pen caps,"
 },
 {
  "start": 7.03,
  "end": 8.14,
  "text": "and sometimes,"
 },
 {
  "start": 8.14,
  "end": 9.316,
  "text": "they breathe one in."
 },
 {
  "start": 9.336,
  "end": 10.276,
  "text": "So pen makers"
 },
 {
  "start": 10.276,
  "end": 11.62,
  "text": "put a hole in the cap."
 },
 {
  "start": 11.64,
  "end": 12.39,
  "text": "If one gets stuck"
 },
 {
  "start": 12.39,
  "end": 13.671,
  "text": "in someone's airway,"
 },
 {
  "start": 13.691,
  "end": 14.431,
  "text": "air can still squeeze"
 },
 {
  "start": 14.431,
  "end": 15.679,
  "text": "through the hole."
 },
 {
  "start": 15.699,
  "end": 16.569,
  "text": "That tiny gap"
 },
 {
  "start": 16.569,
  "end": 17.959,
  "text": "can buy precious seconds"
 },
 {
  "start": 17.959,
  "end": 19.389,
  "text": "until help arrives."
 },
 {
  "start": 19.409,
  "end": 21.679,
  "text": "It's even written into"
 },
 {
  "start": 21.679,
  "end": 23.439,
  "text": "a safety standard:"
 },
 {
  "start": 23.439,
  "end": 24.442,
  "text": "ISO 11540."
 },
 {
  "start": 24.462,
  "end": 25.772,
  "text": "Not every design"
 },
 {
  "start": 25.772,
  "end": 26.708,
  "text": "is about looks."
 },
 {
  "start": 26.728,
  "end": 27.248,
  "text": "Some are about"
 },
 {
  "start": 27.248,
  "end": 28.492,
  "text": "saving a life."
 },
 {
  "start": 28.512,
  "end": 29.412,
  "text": "Follow for more"
 },
 {
  "start": 29.412,
  "end": 30.199,
  "text": "hidden designs."
 }
]
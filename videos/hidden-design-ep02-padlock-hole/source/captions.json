[
 {
  "start": 0.15,
  "end": 1.44,
  "text": "Flip a padlock over."
 },
 {
  "start": 1.44,
  "end": 2.844,
  "text": "See that tiny hole?"
 },
 {
  "start": 2.864,
  "end": 4.526,
  "text": "It's not a second keyhole."
 },
 {
  "start": 4.546,
  "end": 5.336,
  "text": "And it's not"
 },
 {
  "start": 5.336,
  "end": 6.463,
  "text": "for picking the lock."
 },
 {
  "start": 6.483,
  "end": 7.833,
  "text": "Padlocks live outside,"
 },
 {
  "start": 7.833,
  "end": 8.724,
  "text": "in the rain."
 },
 {
  "start": 8.744,
  "end": 10.688,
  "text": "Water sneaks inside the lock."
 },
 {
  "start": 10.708,
  "end": 11.708,
  "text": "With no way out,"
 },
 {
  "start": 11.708,
  "end": 12.955,
  "text": "it just sits there,"
 },
 {
  "start": 12.975,
  "end": 14.055,
  "text": "rusting the parts,"
 },
 {
  "start": 14.055,
  "end": 15.986,
  "text": "or freezing solid in winter."
 },
 {
  "start": 16.006,
  "end": 17.72,
  "text": "That little hole is a drain."
 },
 {
  "start": 17.74,
  "end": 19.13,
  "text": "The water simply runs out"
 },
 {
  "start": 19.13,
  "end": 20.015,
  "text": "the bottom."
 },
 {
  "start": 20.035,
  "end": 20.925,
  "text": "It can even help you"
 },
 {
  "start": 20.925,
  "end": 22.034,
  "text": "oil the lock."
 },
 {
  "start": 22.054,
  "end": 22.884,
  "text": "Small hole."
 },
 {
  "start": 22.884,
  "end": 24.014,
  "text": "Big reason."
 },
 {
  "start": 24.034,
  "end": 24.934,
  "text": "Follow for more"
 },
 {
  "start": 24.934,
  "end": 25.721,
  "text": "hidden designs."
 }
]
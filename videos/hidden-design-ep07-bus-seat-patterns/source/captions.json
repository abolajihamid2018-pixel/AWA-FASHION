[
 {
  "start": 0.15,
  "end": 0.95,
  "text": "Ever wondered why"
 },
 {
  "start": 0.95,
  "end": 2.683,
  "text": "bus seats look like this?"
 },
 {
  "start": 2.703,
  "end": 4.793,
  "text": "Like a carpet from 1987"
 },
 {
  "start": 4.793,
  "end": 6.063,
  "text": "had a bad dream."
 },
 {
  "start": 6.083,
  "end": 7.283,
  "text": "It's not bad taste."
 },
 {
  "start": 7.283,
  "end": 8.597,
  "text": "It's camouflage."
 },
 {
  "start": 8.617,
  "end": 9.737,
  "text": "Thousands of people"
 },
 {
  "start": 9.737,
  "end": 10.955,
  "text": "sit there every week."
 },
 {
  "start": 10.975,
  "end": 11.865,
  "text": "Coffee spills."
 },
 {
  "start": 11.865,
  "end": 12.725,
  "text": "Muddy bags."
 },
 {
  "start": 12.725,
  "end": 13.976,
  "text": "Mystery stains."
 },
 {
  "start": 13.996,
  "end": 15.072,
  "text": "Is that wet?"
 },
 {
  "start": 15.092,
  "end": 16.102,
  "text": "On a plain seat,"
 },
 {
  "start": 16.102,
  "end": 17.905,
  "text": "you'd see every single mark."
 },
 {
  "start": 17.925,
  "end": 19.055,
  "text": "On a busy pattern,"
 },
 {
  "start": 19.055,
  "end": 20.609,
  "text": "your brain can't find them."
 },
 {
  "start": 20.629,
  "end": 21.949,
  "text": "So the seat looks cleaner"
 },
 {
  "start": 21.949,
  "end": 22.967,
  "text": "than it really is."
 },
 {
  "start": 22.987,
  "end": 24.057,
  "text": "The pattern also hides"
 },
 {
  "start": 24.057,
  "end": 25.237,
  "text": "wear and tear,"
 },
 {
  "start": 25.237,
  "end": 26.347,
  "text": "and makes scribbles"
 },
 {
  "start": 26.347,
  "end": 27.23,
  "text": "harder to spot."
 },
 {
  "start": 27.25,
  "end": 28.05,
  "text": "So the seats can stay"
 },
 {
  "start": 28.05,
  "end": 29.733,
  "text": "in service for longer."
 },
 {
  "start": 29.753,
  "end": 30.563,
  "text": "Ugly? Maybe."
 },
 {
  "start": 30.563,
  "end": 32.4,
  "text": "Genius? Absolutely."
 },
 {
  "start": 32.42,
  "end": 33.78,
  "text": "Next time you sit down,"
 },
 {
  "start": 33.78,
  "end": 34.83,
  "text": "maybe don't think about it"
 },
 {
  "start": 34.83,
  "end": 35.742,
  "text": "too hard."
 },
 {
  "start": 35.762,
  "end": 36.662,
  "text": "Follow for more"
 },
 {
  "start": 36.662,
  "end": 37.449,
  "text": "hidden designs."
 }
]
[
 {
  "start": 0.15,
  "end": 1.31,
  "text": "Smoking on planes"
 },
 {
  "start": 1.31,
  "end": 3.118,
  "text": "has been banned for decades."
 },
 {
  "start": 3.138,
  "end": 4.018,
  "text": "So why is there still"
 },
 {
  "start": 4.018,
  "end": 5.783,
  "text": "an ashtray in the bathroom?"
 },
 {
  "start": 5.803,
  "end": 6.833,
  "text": "Wait. What?"
 },
 {
  "start": 6.853,
  "end": 7.983,
  "text": "It's not a mistake."
 },
 {
  "start": 7.983,
  "end": 9.026,
  "text": "It's the law."
 },
 {
  "start": 9.046,
  "end": 10.876,
  "text": "Aviation rules require"
 },
 {
  "start": 10.876,
  "end": 11.706,
  "text": "an ashtray near"
 },
 {
  "start": 11.706,
  "end": 13.246,
  "text": "every lavatory door,"
 },
 {
  "start": 13.246,
  "end": 15.362,
  "text": "even on non-smoking planes."
 },
 {
  "start": 15.382,
  "end": 16.452,
  "text": "Because engineers know"
 },
 {
  "start": 16.452,
  "end": 18.159,
  "text": "one thing about people."
 },
 {
  "start": 18.179,
  "end": 19.009,
  "text": "Someone will break"
 },
 {
  "start": 19.009,
  "end": 20.261,
  "text": "the rules anyway."
 },
 {
  "start": 20.281,
  "end": 21.746,
  "text": "Just one. Real quick."
 },
 {
  "start": 21.766,
  "end": 22.896,
  "text": "And when they panic,"
 },
 {
  "start": 22.896,
  "end": 24.59,
  "text": "where does that cigarette go?"
 },
 {
  "start": 24.61,
  "end": 26.11,
  "text": "Straight into the trash bin,"
 },
 {
  "start": 26.11,
  "end": 28.027,
  "text": "full of dry paper towels."
 },
 {
  "start": 28.047,
  "end": 28.807,
  "text": "On a plane, a fire"
 },
 {
  "start": 28.807,
  "end": 30.864,
  "text": "is the last thing you want."
 },
 {
  "start": 30.884,
  "end": 31.964,
  "text": "So the ashtray gives them"
 },
 {
  "start": 31.964,
  "end": 33.782,
  "text": "a safe place to put it out."
 },
 {
  "start": 33.802,
  "end": 35.512,
  "text": "Rules are for most people."
 },
 {
  "start": 35.512,
  "end": 37.387,
  "text": "Design is for everyone else."
 },
 {
  "start": 37.407,
  "end": 39.147,
  "text": "And yes, smoking on a plane"
 },
 {
  "start": 39.147,
  "end": 40.437,
  "text": "can still get you fined."
 },
 {
  "start": 40.437,
  "end": 41.44,
  "text": "Big time."
 },
 {
  "start": 41.46,
  "end": 42.36,
  "text": "Follow for more"
 },
 {
  "start": 42.36,
  "end": 43.147,
  "text": "hidden designs."
 }
]
[
 {
  "start": 0.15,
  "end": 1.18,
  "text": "That tiny pocket"
 },
 {
  "start": 1.18,
  "end": 2.836,
  "text": "inside your jeans pocket?"
 },
 {
  "start": 2.856,
  "end": 4.353,
  "text": "What is it even for?"
 },
 {
  "start": 4.373,
  "end": 4.593,
  "text": "Is it for"
 },
 {
  "start": 4.593,
  "end": 6.058,
  "text": "one single grape?"
 },
 {
  "start": 6.078,
  "end": 8.264,
  "text": "Let's go back to the 1800s."
 },
 {
  "start": 8.284,
  "end": 9.494,
  "text": "Cowboys, miners,"
 },
 {
  "start": 9.494,
  "end": 10.474,
  "text": "and railroad workers"
 },
 {
  "start": 10.474,
  "end": 12.374,
  "text": "wore tough denim jeans."
 },
 {
  "start": 12.394,
  "end": 13.254,
  "text": "And many of them"
 },
 {
  "start": 13.254,
  "end": 14.808,
  "text": "carried pocket watches."
 },
 {
  "start": 14.828,
  "end": 16.398,
  "text": "But a watch in a big pocket"
 },
 {
  "start": 16.398,
  "end": 16.998,
  "text": "gets scratched,"
 },
 {
  "start": 16.998,
  "end": 18.523,
  "text": "smashed, or lost."
 },
 {
  "start": 18.543,
  "end": 20.363,
  "text": "So jeans got a tiny pocket,"
 },
 {
  "start": 20.363,
  "end": 21.803,
  "text": "just the right size."
 },
 {
  "start": 21.823,
  "end": 23.123,
  "text": "That's why it's called"
 },
 {
  "start": 23.123,
  "end": 23.908,
  "text": "the watch pocket."
 },
 {
  "start": 23.928,
  "end": 25.728,
  "text": "Pocket watches disappeared."
 },
 {
  "start": 25.728,
  "end": 27.018,
  "text": "The pocket didn't."
 },
 {
  "start": 27.038,
  "end": 28.488,
  "text": "Today it holds coins,"
 },
 {
  "start": 28.488,
  "end": 29.538,
  "text": "keys, guitar picks,"
 },
 {
  "start": 29.538,
  "end": 30.558,
  "text": "and mostly,"
 },
 {
  "start": 30.558,
  "end": 31.93,
  "text": "absolutely nothing."
 },
 {
  "start": 31.95,
  "end": 33.352,
  "text": "I'm keeping the grape."
 },
 {
  "start": 33.372,
  "end": 34.272,
  "text": "Follow for more"
 },
 {
  "start": 34.272,
  "end": 35.06,
  "text": "hidden designs."
 }
]
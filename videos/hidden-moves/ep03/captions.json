[
 {
  "start": 0.15,
  "end": 1.35,
  "text": "Why does everyone"
 },
 {
  "start": 1.35,
  "end": 2.75,
  "text": "end up standing at concerts?"
 },
 {
  "start": 2.77,
  "end": 3.97,
  "text": "Nobody planned it."
 },
 {
  "start": 3.97,
  "end": 5.16,
  "text": "Nobody wants it."
 },
 {
  "start": 5.16,
  "end": 6.333,
  "text": "It just happens."
 },
 {
  "start": 6.353,
  "end": 7.677,
  "text": "Let's play the game."
 },
 {
  "start": 7.697,
  "end": 9.267,
  "text": "A crowd, all sitting."
 },
 {
  "start": 9.267,
  "end": 10.86,
  "text": "Everyone can see the stage."
 },
 {
  "start": 10.88,
  "end": 12.91,
  "text": "Then one person near the front"
 },
 {
  "start": 12.91,
  "end": 13.39,
  "text": "stands up."
 },
 {
  "start": 13.39,
  "end": 14.36,
  "text": "They see better,"
 },
 {
  "start": 14.36,
  "end": 15.86,
  "text": "and the person behind them"
 },
 {
  "start": 15.86,
  "end": 16.555,
  "text": "sees nothing."
 },
 {
  "start": 16.575,
  "end": 17.836,
  "text": "Hey! Down in front!"
 },
 {
  "start": 17.856,
  "end": 19.036,
  "text": "So they stand too."
 },
 {
  "start": 19.036,
  "end": 20.556,
  "text": "Then the row behind them."
 },
 {
  "start": 20.556,
  "end": 21.566,
  "text": "Row by row,"
 },
 {
  "start": 21.566,
  "end": 22.586,
  "text": "it ripples back."
 },
 {
  "start": 22.606,
  "end": 24.326,
  "text": "Until everyone is standing,"
 },
 {
  "start": 24.326,
  "end": 25.706,
  "text": "and nobody sees any better"
 },
 {
  "start": 25.706,
  "end": 27.356,
  "text": "than when they were all sitting."
 },
 {
  "start": 27.356,
  "end": 28.867,
  "text": "They're just more tired."
 },
 {
  "start": 28.887,
  "end": 30.197,
  "text": "Each move makes sense"
 },
 {
  "start": 30.197,
  "end": 30.907,
  "text": "on its own."
 },
 {
  "start": 30.907,
  "end": 32.857,
  "text": "Together, they cancel out."
 },
 {
  "start": 32.857,
  "end": 33.677,
  "text": "Economists call this"
 },
 {
  "start": 33.677,
  "end": 35.033,
  "text": "an arms race."
 },
 {
  "start": 35.053,
  "end": 36.403,
  "text": "You see it when everyone"
 },
 {
  "start": 36.403,
  "end": 37.543,
  "text": "talks louder"
 },
 {
  "start": 37.543,
  "end": 38.543,
  "text": "in a noisy restaurant,"
 },
 {
  "start": 38.543,
  "end": 40.213,
  "text": "or rivals keep outspending"
 },
 {
  "start": 40.213,
  "end": 41.471,
  "text": "each other on ads."
 },
 {
  "start": 41.491,
  "end": 43.291,
  "text": "The way out is a shared rule,"
 },
 {
  "start": 43.291,
  "end": 44.451,
  "text": "like everyone agreeing"
 },
 {
  "start": 44.451,
  "end": 45.346,
  "text": "to stay seated."
 },
 {
  "start": 45.366,
  "end": 46.706,
  "text": "Everything is a game."
 },
 {
  "start": 46.706,
  "end": 48.011,
  "text": "These are the hidden moves."
 }
]
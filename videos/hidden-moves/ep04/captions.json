[
 {
  "start": 0.15,
  "end": 1.28,
  "text": "Why do companies sell"
 },
 {
  "start": 1.28,
  "end": 3.334,
  "text": "an option that nobody buys?"
 },
 {
  "start": 3.354,
  "end": 4.504,
  "text": "It's not a mistake."
 },
 {
  "start": 4.504,
  "end": 5.487,
  "text": "It's a decoy."
 },
 {
  "start": 5.507,
  "end": 9.337,
  "text": "The Economist once offered this."
 },
 {
  "start": 9.337,
  "end": 10.687,
  "text": "Web only: $59."
 },
 {
  "start": 10.687,
  "end": 12.597,
  "text": "Print only: $125."
 },
 {
  "start": 12.597,
  "end": 14.527,
  "text": "Print and web:"
 },
 {
  "start": 14.527,
  "end": 15.637,
  "text": "also $125."
 },
 {
  "start": 15.657,
  "end": 17.147,
  "text": "Print only is pointless."
 },
 {
  "start": 17.147,
  "end": 18.132,
  "text": "Who would pick it?"
 },
 {
  "start": 18.152,
  "end": 19.037,
  "text": "Not me."
 },
 {
  "start": 19.057,
  "end": 21.297,
  "text": "Behavioural economist Dan Ariely"
 },
 {
  "start": 21.297,
  "end": 23.797,
  "text": "tested the offer on students."
 },
 {
  "start": 23.797,
  "end": 25.077,
  "text": "With all three options,"
 },
 {
  "start": 25.077,
  "end": 27.14,
  "text": "84% chose print and web."
 },
 {
  "start": 27.16,
  "end": 28.09,
  "text": "Then he removed"
 },
 {
  "start": 28.09,
  "end": 29.41,
  "text": "the useless option."
 },
 {
  "start": 29.41,
  "end": 31.25,
  "text": "Now most chose web only,"
 },
 {
  "start": 31.25,
  "end": 32.62,
  "text": "and print and web"
 },
 {
  "start": 32.62,
  "end": 33.895,
  "text": "fell to 32%."
 },
 {
  "start": 33.915,
  "end": 35.015,
  "text": "Same products."
 },
 {
  "start": 35.015,
  "end": 36.025,
  "text": "Same prices."
 },
 {
  "start": 36.025,
  "end": 37.275,
  "text": "An option nobody wanted"
 },
 {
  "start": 37.275,
  "end": 39.597,
  "text": "changed what everyone chose."
 },
 {
  "start": 39.617,
  "end": 40.887,
  "text": "Next to the decoy,"
 },
 {
  "start": 40.887,
  "end": 41.507,
  "text": "the bundle looks"
 },
 {
  "start": 41.507,
  "end": 42.968,
  "text": "like a free upgrade."
 },
 {
  "start": 42.988,
  "end": 43.768,
  "text": "So when one option"
 },
 {
  "start": 43.768,
  "end": 45.878,
  "text": "makes another look like a steal,"
 },
 {
  "start": 45.878,
  "end": 47.517,
  "text": "ask who it's really there for."
 },
 {
  "start": 47.537,
  "end": 48.877,
  "text": "Everything is a game."
 },
 {
  "start": 48.877,
  "end": 50.182,
  "text": "These are the hidden moves."
 }
]
[
 {
  "start": 0.15,
  "end": 1.87,
  "text": "Why do rival gas stations"
 },
 {
  "start": 1.87,
  "end": 2.56,
  "text": "always end up"
 },
 {
  "start": 2.56,
  "end": 4.299,
  "text": "right next to each other?"
 },
 {
  "start": 4.319,
  "end": 5.419,
  "text": "Sharing customers sounds"
 },
 {
  "start": 5.419,
  "end": 7.252,
  "text": "like terrible business."
 },
 {
  "start": 7.272,
  "end": 8.717,
  "text": "So let's play the game."
 },
 {
  "start": 8.737,
  "end": 9.597,
  "text": "One road."
 },
 {
  "start": 9.597,
  "end": 11.027,
  "text": "Drivers spread evenly."
 },
 {
  "start": 11.027,
  "end": 11.907,
  "text": "Everyone fills up"
 },
 {
  "start": 11.907,
  "end": 13.673,
  "text": "at the closest station."
 },
 {
  "start": 13.693,
  "end": 15.123,
  "text": "Pip sets up at one end."
 },
 {
  "start": 15.123,
  "end": 16.103,
  "text": "Dot at the other."
 },
 {
  "start": 16.103,
  "end": 17.424,
  "text": "Half the road each."
 },
 {
  "start": 17.444,
  "end": 18.362,
  "text": "Ooh. Wait."
 },
 {
  "start": 18.382,
  "end": 20.192,
  "text": "Pip slides toward the middle."
 },
 {
  "start": 20.192,
  "end": 21.312,
  "text": "Everyone behind"
 },
 {
  "start": 21.312,
  "end": 22.622,
  "text": "still comes to Pip,"
 },
 {
  "start": 22.622,
  "end": 24.627,
  "text": "plus a chunk of Dot's drivers."
 },
 {
  "start": 24.647,
  "end": 26.107,
  "text": "So Dot slides in too,"
 },
 {
  "start": 26.107,
  "end": 27.362,
  "text": "and steals them back."
 },
 {
  "start": 27.382,
  "end": 28.562,
  "text": "Move, counter-move,"
 },
 {
  "start": 28.562,
  "end": 29.512,
  "text": "until they're back to back"
 },
 {
  "start": 29.512,
  "end": 30.775,
  "text": "in the center."
 },
 {
  "start": 30.795,
  "end": 32.215,
  "text": "And now they're stuck."
 },
 {
  "start": 32.215,
  "end": 32.735,
  "text": "Whoever steps away"
 },
 {
  "start": 32.735,
  "end": 33.835,
  "text": "hands the other"
 },
 {
  "start": 33.835,
  "end": 34.694,
  "text": "a bigger share."
 },
 {
  "start": 34.714,
  "end": 36.764,
  "text": "This is Hotelling's Law,"
 },
 {
  "start": 36.764,
  "end": 39.057,
  "text": "first described in 1929."
 },
 {
  "start": 39.078,
  "end": 39.888,
  "text": "The twist?"
 },
 {
  "start": 39.888,
  "end": 40.608,
  "text": "Drivers at the ends"
 },
 {
  "start": 40.608,
  "end": 42.337,
  "text": "now drive farther."
 },
 {
  "start": 42.337,
  "end": 42.608,
  "text": "Two stations"
 },
 {
  "start": 42.608,
  "end": 44.167,
  "text": "at the quarter marks"
 },
 {
  "start": 44.167,
  "end": 45.407,
  "text": "would split customers"
 },
 {
  "start": 45.407,
  "end": 46.508,
  "text": "just the same,"
 },
 {
  "start": 46.508,
  "end": 48.102,
  "text": "and serve everyone better."
 },
 {
  "start": 48.122,
  "end": 50.242,
  "text": "Real towns add other reasons,"
 },
 {
  "start": 50.242,
  "end": 51.542,
  "text": "like busy corners."
 },
 {
  "start": 51.542,
  "end": 51.962,
  "text": "But this pull"
 },
 {
  "start": 51.962,
  "end": 53.652,
  "text": "shows up everywhere."
 },
 {
  "start": 53.652,
  "end": 54.522,
  "text": "Coffee shops."
 },
 {
  "start": 54.522,
  "end": 55.612,
  "text": "Even politicians"
 },
 {
  "start": 55.612,
  "end": 57.156,
  "text": "chasing the middle."
 },
 {
  "start": 57.176,
  "end": 58.516,
  "text": "Everything is a game."
 },
 {
  "start": 58.516,
  "end": 59.821,
  "text": "These are the hidden moves."
 }
]